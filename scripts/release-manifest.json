{
  "about": "What the public release commit holds (scripts/release-squash.ts). A tracked file ships when it matches an include pattern and no exclude pattern. Patterns: * is any run inside one folder level, ** crosses folders, a trailing / means everything below. Anything not matched is left out, and the dry run lists it by folder so a new top-level file never goes missing unnoticed.",
  "include": [
    ".claude-plugin/**",
    ".claude/agents/**",
    ".claude/rules/**",
    ".claude/skills/**",
    ".claude/settings.json",
    ".claude/studio.yaml",
    ".claude/verify.json",
    ".github/**",
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CREDITS.md",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SPEC-v0.2.md",
    "SPEC-v0.3.md",
    "SPEC-v0.4.md",
    "SPEC-v0.5.md",
    "SPEC-v0.7.md",
    "SPEC-v0.8.md",
    "SPEC-v3.md",
    "SPEC.md",
    "THIRD-PARTY-NOTICES.md",
    "TRY-IT.md",
    "docs/**",
    "library/**",
    "plugin/**",
    "scripts/**",
    "src/**",
    "test/**",
    "web/**",
    "eslint.config.js",
    "package.json",
    "package-lock.json",
    "playwright.config.ts",
    "tsconfig.json",
    "tsconfig.node.json",
    "vite.config.ts",
    "vite.plugin.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    ".claude/runs/**",
    ".claude/settings.local.json",
    ".claude/**/*.local.*",
    "**/.env",
    "**/.env.*",
    "**/.DS_Store",
    "**/*.log",
    "**/node_modules/**",
    "dist/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "scratch/**",
    "**/scratch/**",
    "docs/benchmarks.md",
    "docs/launch/comparison.md",
    "docs/launch/faq.md",
    "docs/launch/readme-outline.md",
    "docs/launch/hero.gif",
    "docs/launch/hero.mp4",
    "docs/launch/hero-poster.png"
  ],
  "require": ["package.json", "LICENSE", "README.md", "plugin/runtime/runtime.json", "plugin/.claude-plugin/plugin.json"],
  "dirtyAllowed": ["plugin/", ".claude-plugin/"]
}
